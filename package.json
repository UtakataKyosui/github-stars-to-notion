{
  "name": "github-stars-to-notion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "sync": "node src/cli.ts",
    "test": "node --test",
    "check": "npm run lint && npm run check:types && npm run check:unused",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "check:types": "tsc --noEmit",
    "check:unused": "fallow dead-code"
  },
  "dependencies": {
    "@crustjs/core": "0.5.6",
    "@crustjs/effect": "0.2.3",
    "@crustjs/extensions": "0.5.6",
    "effect": "4.0.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "24.19.2",
    "fallow": "3.35.0",
    "typescript": "7.0.2"
  }
}
